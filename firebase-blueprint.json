{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated practitioner or staff profile with isolated PII and credentials.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "mobile": { "type": "string", "minLength": 7, "maxLength": 24 },
        "photoURL": { "type": "string", "maxLength": 40000 },
        "qualification": { "type": "string", "maxLength": 120 },
        "specialization": { "type": "string", "maxLength": 120 },
        "registrationNumber": { "type": "string", "maxLength": 80 },
        "experience": { "type": "number" },
        "consultationTimings": { "type": "string", "maxLength": 160 },
        "acceptedTerms": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "mobile", "acceptedTerms", "createdAt", "updatedAt"]
    },
    "Clinic": {
      "title": "Clinic",
      "description": "Multi-tenant independent clinic configuration and profile owned by a verified doctor.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "address": { "type": "string", "minLength": 3, "maxLength": 300 },
        "city": { "type": "string", "minLength": 2, "maxLength": 100 },
        "state": { "type": "string", "minLength": 2, "maxLength": 100 },
        "pincode": { "type": "string", "minLength": 4, "maxLength": 12 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "email": { "type": "string", "maxLength": 160 },
        "logoUrl": { "type": "string", "maxLength": 40000 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "joiningCode": { "type": "string", "maxLength": 24 },
        "joiningCodeActive": { "type": "boolean" },
        "consultationFee": { "type": "number" },
        "currency": { "type": "string", "enum": ["INR"] },
        "openingTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "closingTime": { "type": "string", "minLength": 4, "maxLength": 10 },
        "workingDays": { "type": "array" },
        "appointmentDuration": { "type": "number" },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 64 },
        "receptionistPermissions": { "type": "object" },
        "whatsappSettings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name", "address", "city", "state", "pincode", "phone",
        "ownerId", "joiningCode", "joiningCodeActive",
        "consultationFee", "currency", "openingTime", "closingTime",
        "workingDays", "appointmentDuration", "createdAt", "updatedAt"
      ]
    },
    "ClinicMembership": {
      "title": "ClinicMembership",
      "description": "Role and status linking a Firebase UID to a specific clinic.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clinicOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberName": { "type": "string", "maxLength": 120 },
        "memberEmail": { "type": "string", "maxLength": 160 },
        "memberMobile": { "type": "string", "maxLength": 24 },
        "role": { "type": "string", "enum": ["owner", "doctor", "receptionist"] },
        "isPractisingDoctor": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "active", "rejected", "revoked"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "revokedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clinicId", "userId", "role", "status", "joinedAt"]
    },
    "ClinicCode": {
      "title": "ClinicCode",
      "description": "Unique human-readable clinic joining code registry exposing only public clinic display info.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "publicName": { "type": "string", "maxLength": 140 },
        "publicAddress": { "type": "string", "maxLength": 300 },
        "publicCity": { "type": "string", "maxLength": 100 },
        "publicState": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clinicId", "ownerId", "active", "createdAt"]
    },
    "ClinicJoinRequest": {
      "title": "ClinicJoinRequest",
      "description": "Receptionist joining request awaiting review by the clinic owner.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clinicOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clinicName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "applicantName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "applicantEmail": { "type": "string", "minLength": 5, "maxLength": 160 },
        "applicantMobile": { "type": "string", "minLength": 7, "maxLength": 24 },
        "requestedRole": { "type": "string", "enum": ["receptionist"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "requestedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "clinicId", "clinicOwnerId", "clinicName", "userId",
        "applicantName", "applicantEmail", "applicantMobile",
        "requestedRole", "status", "requestedAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for doctor or receptionist workspace events.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "join_request_submitted",
            "join_request_received",
            "request_approved",
            "request_rejected",
            "access_revoked",
            "queue_patient_added",
            "queue_patient_resumed",
            "queue_updated",
            "queue_patient_accepted",
            "queue_consultation_completed",
            "queue_patient_held",
            "queue_patient_skipped",
            "queue_patient_called",
            "appointment_scheduled",
            "appointment_confirmed",
            "appointment_reschedule_requested",
            "appointment_rescheduled",
            "appointment_cancelled"
          ]
        },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "message": { "type": "string", "minLength": 2, "maxLength": 400 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "clinicId", "type", "title", "message", "read", "createdAt"]
    },
    "StaffAuditLog": {
      "title": "StaffAuditLog",
      "description": "Immutable audit trail for staff approval, rejection, and revocation.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clinicOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "action": { "type": "string", "enum": ["approved_receptionist", "rejected_request", "revoked_access"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clinicId", "clinicOwnerId", "actorUid", "targetUid", "targetName", "action", "createdAt"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Clinic-scoped patient demographic and basic intake record.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24, "pattern": "^PAT-20[0-9]{2}-[0-9]{4,}$" },
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "fullNameLower": { "type": "string", "minLength": 2, "maxLength": 120 },
        "dateOfBirth": { "type": "string", "maxLength": 10 },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "mobile": { "type": "string", "minLength": 7, "maxLength": 24 },
        "mobileLast10": { "type": "string", "minLength": 7, "maxLength": 15 },
        "alternateMobile": { "type": "string", "maxLength": 24 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "pincode": { "type": "string", "maxLength": 12 },
        "allergies": { "type": "array" },
        "existingConditions": { "type": "array" },
        "currentMedications": { "type": "array" },
        "emergencyContact": { "type": "object" },
        "medicalNotes": { "type": "string", "maxLength": 2000 },
        "registrationDate": { "type": "string", "format": "date-time" },
        "registeredBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "registeredByName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "patientId", "clinicId", "fullName", "fullNameLower", "mobile", "mobileLast10",
        "allergies", "existingConditions", "currentMedications",
        "registrationDate", "registeredBy", "status", "createdAt", "updatedAt"
      ]
    },
    "PatientCounter": {
      "title": "PatientCounter",
      "description": "Atomic per-clinic sequential counter for PAT-YYYY-NNNN ID generation.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "year": { "type": "number" },
        "seq": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clinicId", "year", "seq", "updatedAt"]
    },
    "PatientDoctorNote": {
      "title": "PatientDoctorNote",
      "description": "Doctor-only clinical observations isolated from receptionist read/write access.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientDocId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clinicalNotes": { "type": "string", "maxLength": 5000 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clinicId", "patientDocId", "clinicalNotes", "updatedBy", "updatedAt"]
    },
    "PatientAuditLog": {
      "title": "PatientAuditLog",
      "description": "Immutable audit trail for patient registration, edits, and archiving.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientDocId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24 },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["owner", "doctor", "receptionist"] },
        "action": {
          "type": "string",
          "enum": [
            "registered_patient",
            "updated_demographics",
            "updated_medical_info",
            "updated_clinical_notes",
            "archived_patient",
            "restored_patient"
          ]
        },
        "summary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "patientDocId", "patientId", "patientName",
        "actorUid", "actorName", "actorRole", "action", "summary", "createdAt"
      ]
    },
    "DailyQueueCounter": {
      "title": "DailyQueueCounter",
      "description": "Atomic per-clinic daily queue token counter keyed by YYYY-MM-DD in clinic timezone.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "queueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 64 },
        "seq": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clinicId", "queueDate", "timezone", "seq", "updatedAt"]
    },
    "DailyQueueEntry": {
      "title": "DailyQueueEntry",
      "description": "Real-time daily patient queue entry with atomic token numbering and strict state transitions.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24, "pattern": "^PAT-20[0-9]{2}-[0-9]{4,}$" },
        "patientDocumentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "patientAge": { "type": "number" },
        "patientGender": { "type": "string", "enum": ["male", "female", "other"] },
        "patientMobile": { "type": "string", "minLength": 7, "maxLength": 24 },
        "tokenNumber": { "type": "number" },
        "tokenLabel": { "type": "string", "minLength": 3, "maxLength": 10 },
        "queueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": ["waiting", "called", "in_consultation", "on_hold", "skipped", "completed", "cancelled"]
        },
        "assignedDoctorId": { "type": "string", "maxLength": 128 },
        "assignedDoctorName": { "type": "string", "maxLength": 120 },
        "priority": { "type": "boolean" },
        "priorityChangedBy": { "type": "string", "maxLength": 128 },
        "priorityChangedByName": { "type": "string", "maxLength": 120 },
        "priorityReason": { "type": "string", "maxLength": 240 },
        "cancelReason": { "type": "string", "maxLength": 240 },
        "arrivalTime": { "type": "string", "format": "date-time" },
        "calledAt": { "type": "string", "format": "date-time" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "patientId", "patientDocumentId", "patientName",
        "tokenNumber", "tokenLabel", "queueDate", "timezone", "status",
        "priority", "arrivalTime", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "QueueAuditLog": {
      "title": "QueueAuditLog",
      "description": "Immutable audit log for all queue additions, status changes, priorities, resumes, and cancellations.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "queueDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "entryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tokenNumber": { "type": "number" },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24 },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["owner", "doctor", "receptionist"] },
        "action": {
          "type": "string",
          "enum": [
            "added_to_queue",
            "called_patient",
            "accepted_patient",
            "held_patient",
            "skipped_patient",
            "resumed_patient",
            "completed_consultation",
            "cancelled_entry",
            "priority_updated"
          ]
        },
        "summary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "reason": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "queueDate", "entryId", "tokenNumber", "patientId", "patientName",
        "actorUid", "actorName", "actorRole", "action", "summary", "createdAt"
      ]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Doctor consultation workspace record with symptoms, clinical observations, diagnosis, and advice.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24, "pattern": "^PAT-20[0-9]{2}-[0-9]{4,}$" },
        "patientDocumentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "queueEntryId": { "type": "string", "maxLength": 128 },
        "queueDate": { "type": "string", "maxLength": 10 },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "chiefComplaint": { "type": "string", "maxLength": 500 },
        "symptoms": { "type": "array" },
        "symptomDuration": { "type": "string", "maxLength": 120 },
        "additionalSymptoms": { "type": "string", "maxLength": 1000 },
        "observations": { "type": "object" },
        "primaryDiagnosis": { "type": "string", "maxLength": 300 },
        "additionalDiagnosis": { "type": "string", "maxLength": 500 },
        "diagnoses": { "type": "array" },
        "clinicalNotes": { "type": "string", "maxLength": 4000 },
        "examinationFindings": { "type": "string", "maxLength": 3000 },
        "doctorAdvice": { "type": "string", "maxLength": 3000 },
        "additionalInstructions": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["draft", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "patientId", "patientDocumentId", "doctorId", "doctorName",
        "symptoms", "observations", "diagnoses", "status", "createdAt", "updatedAt"
      ]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Structured non-AI prescription record supporting draft review, signing finalization, and immutable amendments.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "consultationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24, "pattern": "^PAT-20[0-9]{2}-[0-9]{4,}$" },
        "patientDocumentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "prescriptionNumber": { "type": "string", "minLength": 5, "maxLength": 40 },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "medicines": { "type": "array" },
        "generalInstructions": { "type": "array" },
        "followUpRecommendation": { "type": "string", "maxLength": 300 },
        "followUpDate": { "type": "string", "maxLength": 20 },
        "allergyWarningsSnapshot": { "type": "array" },
        "doctorConfirmedReview": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "finalized"] },
        "version": { "type": "number" },
        "parentPrescriptionId": { "type": "string", "maxLength": 128 },
        "rootPrescriptionId": { "type": "string", "maxLength": 128 },
        "amendmentReason": { "type": "string", "maxLength": 300 },
        "amendedByUid": { "type": "string", "maxLength": 128 },
        "signedByUid": { "type": "string", "maxLength": 128 },
        "signedByName": { "type": "string", "maxLength": 120 },
        "signedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "consultationId", "patientId", "patientDocumentId", "prescriptionNumber",
        "doctorId", "doctorName", "medicines", "generalInstructions", "doctorConfirmedReview",
        "status", "version", "createdAt", "updatedAt"
      ]
    },
    "Medicine": {
      "title": "Medicine",
      "description": "Clinic-scoped medicine master entry supporting generic/brand names, strength, dosage form, route, packaging, and favorite flags.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "medicineName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "genericName": { "type": "string", "maxLength": 140 },
        "brandName": { "type": "string", "maxLength": 140 },
        "strength": { "type": "string", "maxLength": 60 },
        "dosageForm": { "type": "string", "minLength": 2, "maxLength": 40 },
        "route": { "type": "string", "minLength": 2, "maxLength": 40 },
        "packagingInfo": { "type": "string", "maxLength": 140 },
        "defaultUnit": { "type": "string", "maxLength": 30 },
        "isSampleData": { "type": "boolean" },
        "isFavorite": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "searchKeywords": { "type": "string", "maxLength": 450 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "medicineName", "dosageForm", "route",
        "isSampleData", "isFavorite", "status", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "PrescriptionTemplate": {
      "title": "PrescriptionTemplate",
      "description": "Reusable clinic/doctor prescription draft template containing structured medicine items and general advice.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 300 },
        "medicines": { "type": "array" },
        "generalInstructions": { "type": "array" },
        "followUpRecommendation": { "type": "string", "maxLength": 300 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "name", "medicines", "generalInstructions",
        "createdBy", "createdAt", "updatedAt"
      ]
    },
    "PrescriptionAuditLog": {
      "title": "PrescriptionAuditLog",
      "description": "Immutable audit log for prescription drafts, finalization signatures, amendments, and PDF/print actions.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "prescriptionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "consultationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["owner", "doctor"] },
        "action": {
          "type": "string",
          "enum": [
            "created_draft",
            "updated_draft",
            "finalized_prescription",
            "created_amendment",
            "printed_or_downloaded_pdf"
          ]
        },
        "version": { "type": "number" },
        "reason": { "type": "string", "maxLength": 300 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "prescriptionId", "consultationId", "patientId",
        "actorUid", "actorName", "actorRole", "action", "version", "summary", "createdAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinic follow-up or scheduled appointment with conflict-checked slot timing and WhatsApp delivery tracking.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clinicName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "patientDocId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24, "pattern": "^PAT-20[0-9]{2}-[0-9]{4,}$" },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "patientMobile": { "type": "string", "minLength": 7, "maxLength": 24 },
        "patientMobileLast10": { "type": "string", "minLength": 7, "maxLength": 15 },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "consultationId": { "type": "string", "maxLength": 128 },
        "appointmentDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
        "appointmentTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "durationMinutes": { "type": "number" },
        "scheduledAtUtcMs": { "type": "number" },
        "timezone": { "type": "string", "minLength": 3, "maxLength": 64 },
        "appointmentType": { "type": "string", "enum": ["follow_up", "general", "review_reports", "routine_checkup"] },
        "reason": { "type": "string", "maxLength": 300 },
        "additionalInstructions": { "type": "string", "maxLength": 1000 },
        "internalNotes": { "type": "string", "maxLength": 1000 },
        "status": {
          "type": "string",
          "enum": ["scheduled", "confirmed", "reschedule_requested", "completed", "cancelled", "no_show"]
        },
        "cancelReason": { "type": "string", "maxLength": 300 },
        "rescheduleCount": { "type": "number" },
        "whatsappNotificationStatus": {
          "type": "string",
          "enum": ["pending", "sent", "delivered", "read", "failed", "skipped_no_consent", "skipped_not_configured"]
        },
        "whatsappConfirmationSentAt": { "type": "string", "format": "date-time" },
        "lastWhatsappError": { "type": "string", "maxLength": 400 },
        "reminder24hStatus": {
          "type": "string",
          "enum": ["pending", "sent", "failed", "skipped_no_consent", "skipped_not_configured", "not_applicable"]
        },
        "reminder2hStatus": {
          "type": "string",
          "enum": ["pending", "sent", "failed", "skipped_no_consent", "skipped_not_configured", "not_applicable"]
        },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "confirmedVia": { "type": "string", "enum": ["staff", "whatsapp_webhook"] },
        "rescheduleRequestedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdByRole": { "type": "string", "enum": ["owner", "doctor", "receptionist"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "clinicName", "patientDocId", "patientId", "patientName",
        "patientMobile", "patientMobileLast10", "doctorId", "doctorName",
        "appointmentDate", "appointmentTime", "durationMinutes", "scheduledAtUtcMs",
        "timezone", "appointmentType", "status", "rescheduleCount",
        "whatsappNotificationStatus", "reminder24hStatus", "reminder2hStatus",
        "createdBy", "createdByRole", "createdAt", "updatedAt"
      ]
    },
    "AppointmentSlotLock": {
      "title": "AppointmentSlotLock",
      "description": "Atomic doctor-time slot lock preventing concurrent overlapping bookings.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "appointmentDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "appointmentTime": { "type": "string", "minLength": 5, "maxLength": 5 },
        "appointmentId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clinicId", "doctorId", "appointmentDate", "appointmentTime", "active", "updatedAt"]
    },
    "PatientCommPrefs": {
      "title": "PatientCommPrefs",
      "description": "Patient WhatsApp consent and communication preference scoped to a clinic.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientDocId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24 },
        "mobile": { "type": "string", "minLength": 7, "maxLength": 24 },
        "whatsappConsent": { "type": "boolean" },
        "consentTimestamp": { "type": "string", "format": "date-time" },
        "preferredMethod": { "type": "string", "enum": ["whatsapp", "phone", "none"] },
        "whatsappEnabled": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "patientDocId", "patientId", "mobile",
        "whatsappConsent", "preferredMethod", "whatsappEnabled", "updatedBy", "updatedAt"
      ]
    },
    "AppointmentLog": {
      "title": "AppointmentLog",
      "description": "Immutable history of appointment creation, rescheduling, confirmation, completion, and cancellation.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "appointmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientDocId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24 },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["owner", "doctor", "receptionist", "system"] },
        "action": {
          "type": "string",
          "enum": [
            "scheduled",
            "confirmed",
            "rescheduled",
            "reschedule_requested",
            "completed",
            "cancelled",
            "no_show",
            "consent_updated"
          ]
        },
        "previousDate": { "type": "string", "maxLength": 10 },
        "previousTime": { "type": "string", "maxLength": 5 },
        "newDate": { "type": "string", "maxLength": 10 },
        "newTime": { "type": "string", "maxLength": 5 },
        "reason": { "type": "string", "maxLength": 300 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "appointmentId", "patientDocId", "patientId", "patientName",
        "actorUid", "actorName", "actorRole", "action", "summary", "createdAt"
      ]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Idempotent WhatsApp Business Cloud API delivery log for confirmations and scheduled reminders.",
      "type": "object",
      "properties": {
        "clinicId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "appointmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientDocId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "patientId": { "type": "string", "minLength": 10, "maxLength": 24 },
        "patientName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "channel": { "type": "string", "enum": ["whatsapp"] },
        "recipientMobile": { "type": "string", "minLength": 7, "maxLength": 24 },
        "messageType": {
          "type": "string",
          "enum": ["confirmation", "reminder_24h", "reminder_2h", "reschedule", "cancellation"]
        },
        "scheduleSlotKey": { "type": "string", "minLength": 10, "maxLength": 32 },
        "idempotencyKey": { "type": "string", "minLength": 5, "maxLength": 160 },
        "templateName": { "type": "string", "maxLength": 120 },
        "deliveryStatus": {
          "type": "string",
          "enum": ["pending_backend_dispatch", "sent", "delivered", "read", "failed", "skipped_no_consent", "skipped_not_configured"]
        },
        "providerMessageId": { "type": "string", "maxLength": 200 },
        "errorMessage": { "type": "string", "maxLength": 400 },
        "sentAt": { "type": "string", "format": "date-time" },
        "deliveredAt": { "type": "string", "format": "date-time" },
        "readAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clinicId", "appointmentId", "patientDocId", "patientId", "patientName",
        "channel", "recipientMobile", "messageType", "scheduleSlotKey",
        "idempotencyKey", "deliveryStatus", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles keyed by Firebase UID."
    },
    "/clinics/{clinicId}": {
      "schema": { "$ref": "#/entities/Clinic" },
      "description": "Multi-tenant clinic configuration documents."
    },
    "/clinicMemberships/{membershipId}": {
      "schema": { "$ref": "#/entities/ClinicMembership" },
      "description": "User-to-clinic role and membership status records keyed by {clinicId}_{uid}."
    },
    "/clinicCodes/{code}": {
      "schema": { "$ref": "#/entities/ClinicCode" },
      "description": "Unique joining code registry with public clinic name/address preview."
    },
    "/clinicJoinRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ClinicJoinRequest" },
      "description": "Receptionist joining requests keyed by {clinicId}_{uid}."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications scoped per recipientUid."
    },
    "/staffAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/StaffAuditLog" },
      "description": "Immutable staff approval and revocation audit logs."
    },
    "/clinics/{clinicId}/patients/{patientDocId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Clinic-isolated patient records."
    },
    "/clinics/{clinicId}/counters/{counterId}": {
      "schema": { "$ref": "#/entities/PatientCounter" },
      "description": "Atomic sequential patient ID counters scoped per clinic."
    },
    "/clinics/{clinicId}/patients/{patientDocId}/doctorNotes/{noteId}": {
      "schema": { "$ref": "#/entities/PatientDoctorNote" },
      "description": "Doctor-only clinical notes strictly inaccessible to receptionists."
    },
    "/clinics/{clinicId}/patientAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/PatientAuditLog" },
      "description": "Immutable patient audit logs scoped per clinic."
    },
    "/clinics/{clinicId}/dailyQueues/{queueDate}": {
      "schema": { "$ref": "#/entities/DailyQueueCounter" },
      "description": "Atomic daily queue token counter per clinic and date."
    },
    "/clinics/{clinicId}/dailyQueues/{queueDate}/entries/{entryId}": {
      "schema": { "$ref": "#/entities/DailyQueueEntry" },
      "description": "Real-time daily patient queue entries."
    },
    "/clinics/{clinicId}/queueAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/QueueAuditLog" },
      "description": "Immutable audit trail for daily queue transitions and priority assignments."
    },
    "/clinics/{clinicId}/consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/Consultation" },
      "description": "Doctor-restricted clinical consultations scoped per clinic."
    },
    "/clinics/{clinicId}/prescriptions/{prescriptionId}": {
      "schema": { "$ref": "#/entities/Prescription" },
      "description": "Doctor-restricted prescriptions supporting draft, finalized signing, and immutable amendments."
    },
    "/clinics/{clinicId}/medicines/{medicineId}": {
      "schema": { "$ref": "#/entities/Medicine" },
      "description": "Clinic-scoped medicine master catalog managed by doctors."
    },
    "/clinics/{clinicId}/prescriptionTemplates/{templateId}": {
      "schema": { "$ref": "#/entities/PrescriptionTemplate" },
      "description": "Reusable prescription draft templates scoped per clinic."
    },
    "/clinics/{clinicId}/prescriptionAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/PrescriptionAuditLog" },
      "description": "Immutable audit log for prescription creation, signing, amendments, and printing."
    },
    "/clinics/{clinicId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Follow-up and scheduled clinic appointments with conflict validation and WhatsApp tracking."
    },
    "/clinics/{clinicId}/appointmentSlots/{slotKey}": {
      "schema": { "$ref": "#/entities/AppointmentSlotLock" },
      "description": "Atomic doctor-time slot locks preventing overlapping bookings."
    },
    "/clinics/{clinicId}/patientCommPrefs/{patientDocId}": {
      "schema": { "$ref": "#/entities/PatientCommPrefs" },
      "description": "Explicit patient WhatsApp consent and communication preferences."
    },
    "/clinics/{clinicId}/appointmentLogs/{logId}": {
      "schema": { "$ref": "#/entities/AppointmentLog" },
      "description": "Immutable audit trail for appointment scheduling, rescheduling, and cancellations."
    },
    "/clinics/{clinicId}/notificationLogs/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationLog" },
      "description": "Idempotent WhatsApp confirmation and reminder delivery logs."
    }
  }
}
